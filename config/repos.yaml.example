# Профили репозиториев (необязательно). Скопируйте файл куда удобно и задайте путь в ARIO_REPOS
# (само по себе наличие файла ничего не включает).
# Без этого файла работает один профиль `rx`, собранный из RX_PATH, BASE_BRANCH, BRANCH_TEMPLATE
# и ARIO_BUILD_COMMAND из .env.
#
# Выбор репозитория для тикета (один раз при старте, результат пишется в runs/<id>/state.json):
#   1. `ario run <id> --repo <имя>`;
#   2. совпадение с match: префикс area path или тег тикета;
#   3. иначе default. Если подходят сразу два профиля, тикет не берётся в работу.
default: rx
repos:
  rx:
    path: D:\Projects\master\RX      # относительный путь считается от папки этого файла
    base_branch: master
    branch_template: antares/ai-{id}
    build_command: ""                # пусто: dotnet build проекта
    knowledge_dir: .                 # AGENTS.md, agents/, skills/ репозитория; от ARIO_PROJECT_DIR
    write_deny_extra: []             # правила запрета записи сверх config/guardrails.yaml
    files:                           # правила файлов репозитория (добавляются к общим)
      write_deny: []                 # нельзя менять
      read_deny: []                  # нельзя читать и находить
      hide: []                       # нет в поиске, читается по пути (например, сгенерированное)
    match:
      area_path: ['SmartInstruments\Antares']
      tags: []
    # Push и PR оркестратором (необязательно; включается ещё и ARIO_PUBLISH=1). Токен берётся из
    # переменной окружения pat_env (в этот файл токен не пишется), скоуп токена: Code (Read & write).
    # Самому пользователю в репозитории нужны права Contribute, Create branch и Contribute to pull
    # requests. Push без force, только ветки тикета.
    # publish:
    #   url: https://rxtfs.directum.ru/IS-Builder8   # коллекция git-сервера, без проекта
    #   project: Sungero
    #   repository: DirectumRX
    #   target_branch: master                         # по умолчанию base_branch
    #   pat_env: RX_GIT_PAT
    #   remote: origin
    #   draft: false
    #   commit_template: "{id}: {title}"
    #   pr_title_template: "{id}: {title}"
    #   author_name: ArioCodingAgent                  # автор коммита; пусто: настройки git на ноде
    #   author_email: ario@example.com
