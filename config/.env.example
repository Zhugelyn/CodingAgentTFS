# Каталог данных (tickets/, runs/, traces/); по умолчанию текущая папка
ARIO_DATA_DIR=.

# Репозиторий RX, над которым работают агенты
RX_PATH=

# Файл guardrails (обязателен)
ARIO_GUARDRAILS=config/guardrails.yaml

# Папка с AGENTS.md, agents/ и skills/ (по умолчанию текущая)
ARIO_PROJECT_DIR=.

# Базовая ветка RX, от которой создаётся ai/<id>
BASE_BRANCH=master

# Модель (LiteLLM-формат) и ключ OpenRouter
LLM_MODEL=openrouter/qwen/qwen3.8-27b:free
OPENROUTER_API_KEY=

# Штатная команда сборки RX (Directum Launcher). Пусто: dotnet build отдельного проекта
ARIO_BUILD_COMMAND=
