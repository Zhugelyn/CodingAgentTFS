# Каталог данных (tickets/, runs/, traces/); по умолчанию текущая папка
ARIO_DATA_DIR=.

# Репозиторий RX, над которым работают агенты
RX_PATH=

# Профили нескольких репозиториев (необязательно): путь к файлу, образец config/repos.yaml.example.
# Если не задан, работает один профиль из RX_PATH, BASE_BRANCH, BRANCH_TEMPLATE, ARIO_BUILD_COMMAND.
ARIO_REPOS=

# Push и PR оркестратором (S17): нужен блок publish в профиле репозитория (config/repos.yaml.example)
# и токен git-сервера (скоуп Code: Read & write) в переменной, имя которой указано в publish.pat_env
# (например RX_GIT_PAT).
ARIO_PUBLISH=

# Файл guardrails (обязателен)
ARIO_GUARDRAILS=config/guardrails.yaml

# Папка с AGENTS.md, agents/ и skills/ (по умолчанию текущая)
ARIO_PROJECT_DIR=.

# Базовая ветка RX, от которой создаётся ветка тикета
BASE_BRANCH=master

# Имя ветки тикета: обязателен {id}, необязателен {type} (bug, task, user-story).
# Пример: antares/ai-{id} даёт antares/ai-43031. По умолчанию ai/{id}.
BRANCH_TEMPLATE=ai/{id}

# Модель (LiteLLM-формат) и ключ OpenRouter
LLM_MODEL=openrouter/qwen/qwen3.8-27b
OPENROUTER_API_KEY=
# Модель по ролям (необязательно; пусто: берётся LLM_MODEL). Analyst и reviewer лучше на сильной
# модели, developer справится на более дешёвой.
ANALYST_MODEL=
DEVELOPER_MODEL=
REVIEWER_MODEL=

# Штатная команда сборки RX (Directum Launcher). Пусто: dotnet build отдельного проекта
ARIO_BUILD_COMMAND=

# TFS (Azure DevOps Server). TFS_URL: адрес коллекции без проекта. TFS_PAT читает тикеты.
# PAT с правом Work Items: Read; значение хранить только в локальном .env.
TFS_URL=https://tech.directum.ru/Portfolio
TFS_PROJECT=SmartInstruments
TFS_PAT=
# Запрос отбора (WIQL). Пусто: запрос по умолчанию (Bug, тег «AI dev», Antares, не закрытые)
TFS_WIQL=
# Максимум тикетов за один `ario fetch`
TFS_MAX_ITEMS=5

# Запись на доску (комментарии, смена состояния). Выключена, пока TFS_WRITE не равен 1: тогда в
# трассу пишется только то, что было бы записано. Токен записи лучше держать отдельно от токена
# чтения; если TFS_WRITE_PAT пуст, пишет TFS_PAT. Права токена записи: Work Items (Read & write).
TFS_WRITE=
TFS_WRITE_PAT=
# Поток «этап → состояние доски» (образец config/ticket-flow.yaml.example); без файла состояния
# не меняются, пишутся только итоговые комментарии.
ARIO_TICKET_FLOW=

# Экспорт метрик и таймингов прогона (без текста) в Phoenix по OTLP/HTTP. Пусто: не экспортировать.
# Не задавайте OTEL_EXPORTER_OTLP_* и LMNR_*: SDK отправит тексты запросов (харнесс откажется стартовать).
ARIO_OTLP_ENDPOINT=

# Живая выгрузка запросов к модели В ТЕКСТЕ (код RX, тикеты) в локальный Phoenix, проект ArioCodingAgent-LLM.
# Нужны `uv sync --extra telemetry` и локальный ARIO_OTLP_ENDPOINT. Для чужого сервера: ARIO_ALLOW_REMOTE_LLM_CONTENT=1
ARIO_OTLP_LLM_CONTENT=
